# Copy to .env on the server (next to manage.py) and fill in real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=familyenglish.global,www.familyenglish.global
DJANGO_CSRF_TRUSTED_ORIGINS=https://familyenglish.global,https://www.familyenglish.global
# PostgreSQL (cPanel -> PostgreSQL Databases). Names get your cPanel username as a prefix.
FE_DB_NAME=cpaneluser_familyenglish
FE_DB_USER=cpaneluser_feuser
FE_DB_PASSWORD=replace-with-the-database-password
FE_DB_HOST=localhost
FE_DB_PORT=5432
# Set to 0 only until the SSL certificate (AutoSSL) is active, then back to 1.
DJANGO_SSL_REDIRECT=1
