# Copy to .env on the server (next to manage.py) and fill in real values.
FE_SECRET_KEY=replace-with-a-long-random-string
FE_DEBUG=0
FE_ALLOWED_HOSTS=familyenglish.global,www.familyenglish.global
FE_CSRF_TRUSTED_ORIGINS=https://familyenglish.global,https://www.familyenglish.global
# PostgreSQL (cPanel -> PostgreSQL Databases). Names get your cPanel username as a prefix.
FE_DB_NAME=cpaneluser_familyenglish
FE_DB_USER=cpaneluser_feuser
FE_DB_PASSWORD=replace-with-the-database-password
FE_DB_HOST=localhost
FE_DB_PORT=5432
# Set to 0 only until the SSL certificate (AutoSSL) is active, then back to 1.
FE_SSL_REDIRECT=1
# Optional AI tutor, writing helper and speaking feedback (Anthropic API key).
# Leave empty to use the free built-in feedback. FE_AI_DAILY_LIMIT = AI replies per learner per day.
FE_AI_API_KEY=
FE_AI_MODEL=claude-haiku-5-5
FE_AI_DAILY_LIMIT=20
# AI calls per learner per day in Talk lessons (replies, hints, translations, reports, new articles)
FE_TALK_AI_DAILY_LIMIT=60
# Stronger model used only to mark the AI level test (writing, speaking) and write its report
FE_AI_TEST_MODEL=claude-sonnet-5-5

# Refer & earn commission in % of each confirmed payment (0 = off)
FE_REFERRAL_COMMISSION_PCT=10
# Optional: your Facebook page Messenger link for the floating help button, e.g. https://m.me/yourpage
FE_MESSENGER_URL=

# Free YouTube Data API key (Google Cloud console -> YouTube Data API v3 -> Credentials -> API key).
# Used by `python manage.py find_clips` to pick 4-5 short on-topic clips per lesson (max 20 min).
FE_YOUTUBE_API_KEY=

# --- v15: going global ---
# Email for sign-up / sign-in codes (cPanel → Email Accounts → create noreply@familyenglish.global).
# Leave FE_EMAIL_HOST empty to print emails in the server log instead of sending them.
FE_EMAIL_HOST=mail.familyenglish.global
FE_EMAIL_PORT=465
FE_EMAIL_USER=noreply@familyenglish.global
FE_EMAIL_PASSWORD=
FE_EMAIL_FROM=FamilyEnglish <noreply@familyenglish.global>
# SMS codes: none (default), bulksmsbd or twilio
FE_SMS_BACKEND=none
FE_SMS_API_KEY=
FE_SMS_SECRET=
FE_SMS_SENDER=
# Everyone pays (0, default). Set 1 to make families outside Bangladesh free.
FE_FREE_OUTSIDE_BD=0
# SSLCommerz (card, bKash, Nagad, Rocket, internet banking; USD for families abroad).
# Test store: register at https://developer.sslcommerz.com → sandbox. Live: your merchant store ID/password.
FE_SSLC_STORE_ID=
FE_SSLC_STORE_PASSWORD=
FE_SSLC_SANDBOX=1
